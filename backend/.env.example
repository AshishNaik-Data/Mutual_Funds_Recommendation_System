# Every setting is optional; export these (or set os.environ in Colab) before starting.

# LLM backend: hf (local model + LoRA), chat (any LangChain chat model) or none (templates only)
MF_LLM_BACKEND=hf
MF_BASE_MODEL=microsoft/Phi-3-mini-4k-instruct
# Defaults to the newest adapter in ../artifacts/ trained on MF_BASE_MODEL; set only to override
# MF_ADAPTER_PATH=
# For MF_LLM_BACKEND=chat, e.g. openai:<model-name> or anthropic:<model-name>
# MF_CHAT_MODEL=

# Embeddings: a sentence-transformers model, or "hashing" for offline/lexical-only use
MF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# MF_DATA_PATH=../data/updated_data_with_nav.csv
# MF_INDEX_DIR=../artifacts/faiss_index

MF_LIVE_NAV=true
MF_REWRITE_QUERY=true
MF_CORS_ORIGINS=*
